---
import Layout from "$layouts/Layout.astro";
import Person from "$components/Person.astro";
---

<Layout pageTitle="About Us">
    <div id="container">

        <div id="mission-container">
            <h1 class="container-title">Our Mission</h1>
            <a>We are Project Plasma, a student-led team at the University of Sheffield looking at the research and development of a Farnsworth-Hirsch fusor. We provide members of our team the opportunity to develop technical skills wanted by the fusion industry, from working with simulation software to understand plasma physics, to hands-on work integrating systems we have built onto the fusor. By working closely with the University's Nuclear society, ANFS, we also get the opportunity to attend networking events with guest speakers from the fusion sector.</a>
            <a>Our mission is to reach neutron production from Deuterium-Deuterium reactions, and to continue improving on what we have built, hopefully reaching a level of neutron production that is industry competitive.</a>
        </div>

        <br>
        <div id="team-container">
            <h1 class="container-title">Meet The Team</h1>
            <div class="team">
                <Person name="George Viant" role="Health & Safety Lead" imgSrc="/profiles/george.png" />
                <Person name="Joseph Whitehurst" role="Project Lead" imgSrc="/profiles/joseph.png" />
                <Person name="Marren Muriuki" role="Pi Cam | Fusion Outreach" imgSrc="/profiles/marren.png" />
                <Person name="Joe Peers" role="Secretary | Grid Design" imgSrc="/profiles/joepeers.png" />
                <Person name="Marcus James" role="Treasurer | Simulations" imgSrc="/profiles/marcus.png" />

                <Person name="Harry Russin" role="Simulations & Grids" imgSrc="/profiles/harry.png" />
                <Person name="John Winwood" role="High Voltage" imgSrc="/profiles/john.png" />
                <Person name="William Hollick" role="Gas & Pressure" imgSrc="/profiles/pwilliam.png" />
                <Person name="Leela Marlow" role="Simulations & Grids" imgSrc="/profiles/leela.png" />
                <Person name="Austin" role="Lab Lead" imgSrc="/profiles/austin.png" />
            </div>
        </div>

    </div>
</Layout>

<style>
    #container {
        width: 100%;

        display: flex;
        flex-direction: column;
        align-items: center;

        padding: 30px;
        box-sizing: border-box;
    }

    #mission-container {
        max-width: 900px;
    }

    .container-title {
        width: 100%;
        text-align: center;
    }

    a {
        display: block;
        text-align: center;

        margin: 7px;
    }

    .team {
        margin-top: 30px;

        display: flex;
        flex-wrap: wrap;
        justify-content: center;
        gap: 1rem;
    }

    .team * {
    }

</style>
